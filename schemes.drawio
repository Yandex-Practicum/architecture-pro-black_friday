<mxCell id="e-8" value="raft" style="curved=1;html=1;dashed=1;endArrow=open;strokeColor=#2d7600;fontSize=10;fontColor=#2d7600;startArrow=open;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="v-5" target="v-6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="v-9" value='api_gateway&lt;br&gt;&lt;font style="font-size:10px;font-weight:normal"&gt;APISIX, балансировщик, :8080&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="580" width="150" height="60" as="geometry"/></mxCell>
