<mxCell id="v-8" value='configSrv&lt;br&gt;&lt;font style="font-size:10px"&gt;config server, :27017&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="120" height="90" as="geometry"/></mxCell>
