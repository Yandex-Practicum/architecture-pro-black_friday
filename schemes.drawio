<diagram name="5. CDN" id="page-5"><mxGraphModel dx="2240" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="v-1" value="Вариант 5. CDN для статического контента в нескольких регионах" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="v-2" value="Пользователи из разных регионов через GeoDNS попадают на ближайший к ним узел CDN. Статика магазина (HTML, JS, CSS, картинки товаров) отдаётся из кеша узла CDN. При промахе кеша узел CDN забирает файл из origin-хранилища static_storage (origin pull) и кеширует его по TTL. Динамические запросы к API (/helloDoc/users и т. п.) CDN не кеширует, а проксирует в api_gateway. Остальная часть системы — как в варианте 4: клиент обращается только к api_gateway. Каждый инстанс pymongo-api при старте регистрируется в Consul, Consul проверяет инстансы health check-ами и исключает упавшие. api_gateway получает из Consul актуальный список здоровых инстансов сервиса pymongo-api и балансирует запросы между ними (round robin). Чтобы добавить или убрать инстанс, достаточно запустить или остановить его — gateway узнает об этом из Consul. Все инстансы используют общий redis и один кластер MongoDB." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1300" height="60" as="geometry"/></mxCell>
<mxCell id="v-3" value="Consul cluster (Service Discovery)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="750" y="220" width="470" height="130" as="geometry"/></mxCell>
<mxCell id="v-4" value='consul-1&lt;br&gt;&lt;font style="font-size:10px;font-weight:normal"&gt;server, leader, :8500&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="v-3"><mxGeometry x="20" y="45" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="v-5" value='consul-2&lt;br&gt;&lt;font style="font-size:10px;font-weight:normal"&gt;server, :8500&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="v-3"><mxGeometry x="175" y="45" width="120" height="60" as="geometry"/></mxCell>
