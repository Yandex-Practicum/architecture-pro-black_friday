<mxCell id="v-1" value="Вариант 1. Шардирование MongoDB (2 шарда)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="v-2" value="pymongo-api обращается к MongoDB через роутер mongos_router. Роутер получает карту чанков из configSrv и направляет запрос в нужный шард. Коллекция helloDoc шардирована по хешу ключа между shard1 и shard2." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="120" as="geometry"/></mxCell>
